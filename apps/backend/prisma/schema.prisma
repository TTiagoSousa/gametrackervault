generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  hashedPassword String
  role           Role     @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  libraryEntries LibraryEntry[]
  aiSettings     AiSettings?

  @@index([username])
}

// External services configured by the admin in the app. One row per service — the
// key belongs to the whole installation, not to each user.
enum IntegrationProvider {
  IGDB
}

model Integration {
  provider  IntegrationProvider @id
  clientId  String
  // Encrypted with TOKEN_ENCRYPTION_KEY (AES-256-GCM); never leaves the backend
  secret    String
  updatedAt DateTime            @updatedAt
}

// --- Shelf ---------------------------------------------------------------------------

// Where a game sits on a user's shelf. The four shelves on Home
// group them: playing (PLAYING, PAUSED), finished (FINISHED_MAIN,
// FINISHED_EXTRAS, COMPLETED_100), to play (PLAN_TO_PLAY) and dropped.
enum LibraryStatus {
  PLAYING
  PAUSED
  PLAN_TO_PLAY
  FINISHED_MAIN
  FINISHED_EXTRAS
  COMPLETED_100
  DROPPED
}

// Minimal copy of an IGDB game — only what the shelf needs to render
// without calling the API. Shared by all users; the rest of the details always
// come from IGDB.
model Game {
  igdbId       Int      @id
  name         String
  slug         String?
  coverImageId String?
  releaseYear  Int?
  platforms    String[]
  genres       String[] @default([])
  // Average time to beat (hours), from IGDB players: main story,
  // main + extras and 100%. Stats use it when the user
  // didn't enter the hours.
  ttbMain          Float?
  ttbExtras        Float?
  ttbCompletionist Float?
  // When genres and times were fetched from IGDB (null = never)
  factsCheckedAt   DateTime?
  updatedAt    DateTime @updatedAt

  libraryEntries LibraryEntry[]
}

model LibraryEntry {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId      Int
  game        Game          @relation(fields: [gameId], references: [igdbId])
  status      LibraryStatus
  hoursPlayed Float?
  startedAt   DateTime?     @db.Date
  finishedAt  DateTime?     @db.Date
  // Personal rating from 1 to 10
  rating      Int?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, gameId])
  @@index([userId, status])
}

// --- Assistant (AI) --------------------------------------------------------------------

// Assistant provider. For now only Anthropic (Claude).
enum AiProvider {
  ANTHROPIC
}

// Each user's assistant key and model: everyone uses their own account.
model AiSettings {
  userId    String     @id
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  AiProvider @default(ANTHROPIC)
  // Encrypted with TOKEN_ENCRYPTION_KEY (AES-256-GCM); never leaves the backend
  apiKey    String
  // The last 4 characters, to show which key is stored
  keyHint   String
  model     String
  updatedAt DateTime   @updatedAt
}
