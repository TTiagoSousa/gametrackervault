# Configuração do backend. Em desenvolvimento copia para apps/backend/.env; no
# container LXC o instalador gera /etc/gametracker/gametracker.env com estes campos.

NODE_ENV=development
# Em produção o backend só ouve o nginx: HOST=127.0.0.1
HOST=0.0.0.0
PORT=3200

DATABASE_URL="postgresql://gametracker:password@localhost:5432/gametracker"

# Assina a sessão. Qualquer texto longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Endereço por onde se abre a app (origem aceite pelo CORS). O cookie seguro
# segue o protocolo de cada pedido (req.secure), não esta variável.
FRONTEND_URL=http://localhost:5190

# ⚠ NÃO ALTERAR depois de configurar integrações: cifra os segredos guardados na
# base de dados (ex. o Client Secret do IGDB). Mudá-la obriga a voltar a
# introduzi-los no Admin. Base64 de 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
