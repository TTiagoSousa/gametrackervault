# Backend configuration. In development copy to apps/backend/.env; in the
# LXC container the installer generates /etc/gametracker/gametracker.env with these fields.

NODE_ENV=development
# In production the backend only listens to nginx: HOST=127.0.0.1
HOST=0.0.0.0
PORT=3200

DATABASE_URL="postgresql://gametracker:password@localhost:5432/gametracker"

# Signs the session. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Address the app is opened from (origin accepted by CORS). The secure cookie
# follows the protocol of each request (req.secure), not this variable.
FRONTEND_URL=http://localhost:5190

# ⚠ DO NOT CHANGE after configuring integrations: it encrypts the secrets stored in
# the database (e.g. the IGDB Client Secret). Changing it means re-entering
# them in Admin. Base64 of 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
